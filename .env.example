# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://localhost:27017/cf5-tasks

# NextAuth.js — generate with: npx auth secret
AUTH_SECRET=

# Base URL of the app (used for callback URLs); set to your deployed URL in production
AUTH_URL=http://localhost:3000
